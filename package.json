{
  "name": "meme-cv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/pack-models.mjs",
    "lint": "oxlint src scripts e2e vite.config.ts playwright.config.ts",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-wasm.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Real-time browser computer vision: facial expressions and hand gestures matched to cat memes with MediaPipe, TypeScript and Canvas.",
  "homepage": "https://meme-cv.uprosti.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAKes/meme-cv.git"
  },
  "bugs": {
    "url": "https://github.com/NotAKes/meme-cv/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
